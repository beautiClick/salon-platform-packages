{
  "name": "@beauticlick/tokens",
  "version": "0.1.0",
  "description": "Design tokens and the salon-type contract shared by all Salon apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beauticlick/salon-platform-packages.git",
    "directory": "packages/tokens"
  },
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
